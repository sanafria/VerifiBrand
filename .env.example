# ==============================================================================
# BrandLedger Comprehensive Environment Configuration (.env.example)
#
# Copy this file to .env and configure values appropriate for your environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or sensitive credentials to Git!
# ==============================================================================

# ==============================================================================
# 1. CORE BACKEND SERVICE (backend/app/config.py)
# ==============================================================================
# Runtime environment: development, testing, or production
ENVIRONMENT=development

# Server bind host and port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins: comma-separated list of origins permitted to call the API
# Matches the Next.js frontend dev server defaults
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ==============================================================================
# 2. DATABASE CONFIGURATION (backend/app/db.py, docker-compose.yml)
# ==============================================================================
# Local Docker PostgreSQL connection string.
# Default matches docker-compose.yml (port 5433 mapped to container 5432 to avoid local port conflicts)
DATABASE_URL=postgresql://brandledger_user:brandledger_secret@localhost:5433/brandledger

# Optional: Supabase Cloud PostgreSQL configuration (alternative to local Docker)
# Obtain these from Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key


# ==============================================================================
# 3. OPTIONAL AI & LLM CHECKS (backend/app/services/ai_checks.py)
# BrandLedger is deterministic by default. AI is only invoked for ambiguous claims
# or tone checks when configured. Findings still require literal policy citations.
# ==============================================================================
# Set to true to force-disable AI and run 100% deterministic rules
BRANDLEDGER_DISABLE_AI=false

# Primary and fallback API keys for OpenAI-compatible endpoint
BRANDLEDGER_LLM_API_KEY=your-llm-api-key-here
OPENAI_API_KEY=your-openai-api-key-optional

# Custom OpenAI-compatible base URL and model name (defaults: gpt-4o-mini)
BRANDLEDGER_LLM_BASE_URL=https://api.openai.com/v1
BRANDLEDGER_LLM_MODEL=gpt-4o-mini


# ==============================================================================
# 4. FILE EXTRACTION, OCR & VISUAL CHECKS (backend/extraction_module/brandledger_extraction/config.py)
# ==============================================================================
# Optional explicit path to the tesseract binary.
# Leave commented or unset if tesseract is already available on your system PATH.
# macOS (Homebrew Apple Silicon): /opt/homebrew/bin/tesseract
# macOS (Homebrew Intel):        /usr/local/bin/tesseract
# Linux / Ubuntu:                /usr/bin/tesseract
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Primary OCR recognition language (ISO 639-2 code)
BL_OCR_LANG=eng

# Maximum allowed uploaded file size in Megabytes (default: 20 MB)
BL_MAX_FILE_MB=20

# Maximum number of PDF pages to process per document (default: 15 pages)
BL_MAX_PDF_PAGES=15

# Optional custom directory path for approved and deprecated reference logos
# Default: backend/extraction_module/logo_library
# BL_LOGO_LIBRARY=/path/to/custom/logo_library


# ==============================================================================
# 5. FRONTEND NEXT.JS CONFIGURATION (frontend/src/lib/api/policyClient.ts)
# These variables must be prefixed with NEXT_PUBLIC_ to be exposed to the browser.
# ==============================================================================
# URL of the BrandLedger FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Data persistence mode for Policy Library & Brand Passport:
# - false (default): Uses client-side localStorage/in-memory adapter for standalone development
# - true: Communicates directly with the live FastAPI backend (/api/policies)
NEXT_PUBLIC_USE_BACKEND_CRUD=false


# ==============================================================================
# 6. PUBLICATION GATE & CMS WEBHOOK (backend/app/api/gate.py)
# ==============================================================================
# Shared secret for HMAC-SHA256 signature verification on incoming CMS webhooks
CMS_WEBHOOK_SECRET=your-cms-webhook-secret-here


# ==============================================================================
# 7. FETCH.AI AGENT CORE & AGENTVERSE (agent/config.py)
# ==============================================================================
# Target FastAPI backend base URL
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=10.0

# Fetch.ai agent identity
AGENT_NAME=verifibrand_agent
AGENT_PORT=8001
AGENT_SEED=verifibrand-agent-development-seed-do-not-use-in-prod

# Optional Public Webhook Endpoint (HTTPS required in production)
# AGENT_ENDPOINT=https://agent.yourdomain.com/submit

# Agentverse Cloud Mailbox & Registry Integration (https://agentverse.ai)
AGENTVERSE_API_KEY=your-agentverse-api-key-here
AGENTVERSE_MAILBOX=false
AGENT_HANDLE=verifibrand
