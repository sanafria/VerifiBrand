# ==============================================================================
# VerifiBrand Fetch.ai Agent — Configuration Template (.env.example)
# ==============================================================================
# Copy this file to agent/.env or root .env and configure for your environment.
# Never commit real seeds, private keys, or API tokens to source control.

# --- Operational Environment ---
# Runtime mode: 'development', 'testing', or 'production'
# In 'production', default development seeds are strictly rejected.
ENVIRONMENT=development

# --- Backend Communication ---
# Base URL of the BrandLedger FastAPI backend service
BACKEND_URL=http://127.0.0.1:8000
# HTTP timeout in seconds for backend requests
BACKEND_TIMEOUT_SECONDS=10.0

# --- Fetch.ai Agent Identity ---
# Human-readable agent display name
AGENT_NAME=verifibrand_agent
# Local HTTP communication port for the uAgents loop
AGENT_PORT=8001
# Seed phrase for generating the agent's deterministic cryptographic identity and address.
# WARNING: In production, generate a secure, private 12/24-word seed phrase.
AGENT_SEED=verifibrand-agent-development-seed-do-not-use-in-prod

# --- Public Webhook Endpoint (Optional) ---
# Required if exposing agent via public HTTPS rather than Agentverse Mailbox.
# In 'production', must use HTTPS (e.g. https://agent.yourdomain.com/submit).
# AGENT_ENDPOINT=https://agent.yourdomain.com/submit

# --- Agentverse & ASI:One Integration ---
# Agentverse API token for cloud mailbox, directory, and registry services.
# Obtain from https://agentverse.ai -> Profile -> API Keys
AGENTVERSE_API_KEY=your-agentverse-api-key-here
# Enable Agentverse Cloud Mailbox (recommended for local agents behind firewalls/NAT)
AGENTVERSE_MAILBOX=false
# Agentverse unique handle for human-readable discovery
AGENT_HANDLE=verifibrand

# --- Diagnostics & Logging ---
LOG_LEVEL=INFO
